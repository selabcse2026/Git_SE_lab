git switch <previous-branch>
git stash pop

h) Keep a clean feature history when main has new commits.git fetch origin
git switch feature/<name>
git rebase origin/main
# Resolve conflicts if needed:
git add <resolved-files>
git rebase --continue
git push --force-with-lease origin feature/<name>


i) Recover a lost commit.git reflog
git branch recovery <lost-commit-hash>
git switch recovery
# If required, cherry-pick the recovered commit into the working branch.


